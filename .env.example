RENTALL_DEMO_PAYMENTS=true
# Stripe mode must match every key. Prefer a least-privilege restricted key (rk_) where supported.
STRIPE_MODE=test
STRIPE_SECRET_KEY=rk_test_replace_in_railway
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of this app. For local testing:
APP_URL=http://localhost:4242

PORT=4242

# Local development defaults to ./rentall.sqlite. Production must use a Railway volume.
# Railway example: attach the declared volume at /data. Railway sets
# RAILWAY_VOLUME_MOUNT_PATH automatically; do not override it manually.
RENTALL_DB_PATH=
RAILWAY_VOLUME_MOUNT_PATH=
PERSISTENT_DATA_DIR=
# Persist listing uploads on the same single-replica volume.
UPLOADS_DIR=
# DATABASE_URL supports only file: or sqlite:/// in RC45. Do not set it together
# with RENTALL_DB_PATH or DB_PATH; ambiguous/unsupported storage fails closed.
DATABASE_URL=
DB_PATH=

STRIPE_PUBLISHABLE_KEY=pk_test_...
PLATFORM_FEE_PERCENT=15

BOOKING_HOLD_MINUTES=30

# Canonical public origin used by robots.txt/sitemap.xml
PUBLIC_BASE_URL=https://example.com
# Set to the exact number of reverse proxies in production (0 for direct hosting)
TRUST_PROXY_HOPS=0
APP_VERSION=1.0.0-rc.45


# Transactional email. The app safely queues messages even without a provider.
# Production worker/provider integration can consume email_outbox rows.
EMAIL_DELIVERY_MODE=outbox
EMAIL_PROVIDER=
EMAIL_FROM=
SUPPORT_EMAIL=support@example.com

# Strong random bearer token used only by the transactional email worker
EMAIL_WORKER_TOKEN=
EMAIL_MAX_ATTEMPTS=5

# Production launch gate. Store values only in Railway Variables, never in committed files.
# NODE_ENV=production
# APP_URL=https://rentall.example
# SESSION_SECRET=replace-with-at-least-32-random-characters
# STRIPE_MODE=live
# STRIPE_SECRET_KEY=rk_live_restricted_key
# STRIPE_PUBLISHABLE_KEY=pk_live_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_...
# EMAIL_PROVIDER=resend
# EMAIL_FROM=RentAll <bookings@your-verified-domain.example>
# RESEND_API_KEY=re_...
# EMAIL_WORKER_ENABLED=true
# EMAIL_WORKER_TOKEN=replace-with-random-worker-token
# SUPPORT_EMAIL=support@example.com

# Operations
# RENTALL_DB_PATH=/data/rentall.sqlite
# UPLOADS_DIR=/data/uploads
# BACKUP_DIR=./backups

STRIPE_CONNECT_V2_PROVISIONING=false
OBJECT_STORAGE_PROVIDER=
MONITORING_DSN=
MAPS_PROVIDER=stub
MAPS_PUBLIC_TOKEN=
SMS_PROVIDER=disabled
PUSH_PROVIDER=disabled

EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_WORKER_BATCH_SIZE=10
RESEND_API_KEY=
