# Stripe TEST MODE keys only for MVP
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of this app. For local testing:
APP_URL=http://localhost:4242

PORT=4242

# Optional SQLite file path
DB_PATH=./rentall.sqlite

STRIPE_PUBLISHABLE_KEY=pk_test_...
PLATFORM_FEE_PERCENT=15

BOOKING_HOLD_MINUTES=30

# Canonical public origin used by robots.txt/sitemap.xml
PUBLIC_BASE_URL=https://example.com
# Set to the exact number of reverse proxies in production (0 for direct hosting)
TRUST_PROXY_HOPS=0
APP_VERSION=0.53.0


# Transactional email. The app safely queues messages even without a provider.
# Production worker/provider integration can consume email_outbox rows.
EMAIL_DELIVERY_MODE=outbox
EMAIL_PROVIDER=
EMAIL_FROM=
SUPPORT_EMAIL=support@example.com

# Strong random bearer token used only by the transactional email worker
EMAIL_WORKER_TOKEN=
EMAIL_MAX_ATTEMPTS=5

# Production launch gate
# NODE_ENV=production
# APP_URL=https://rentall.example
# SESSION_SECRET=replace-with-at-least-32-random-characters
# STRIPE_SECRET_KEY=sk_live_or_test
# STRIPE_WEBHOOK_SECRET=whsec_...
# EMAIL_PROVIDER=your_provider
# EMAIL_FROM=RentAll <rentals@example.com>
# EMAIL_WORKER_TOKEN=replace-with-random-worker-token
# SUPPORT_EMAIL=support@example.com

# Operations
# DB_PATH=./rentall.db
# BACKUP_DIR=./backups

STRIPE_CONNECT_V2_PROVISIONING=false
OBJECT_STORAGE_PROVIDER=
MONITORING_DSN=
DATABASE_URL=

MAPS_PROVIDER=stub
MAPS_PUBLIC_TOKEN=
SMS_PROVIDER=disabled
PUSH_PROVIDER=disabled

EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_WORKER_BATCH_SIZE=10
RESEND_API_KEY=
